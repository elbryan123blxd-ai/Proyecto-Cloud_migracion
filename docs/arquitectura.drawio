        <!-- S3 de la app (fuera de la VPC, servicio regional) -->
        <mxCell id="s3app" value="Amazon S3&#10;(fotos, PDFs, material)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;fillColor=#277116;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="620" width="78" height="78" as="geometry" />
