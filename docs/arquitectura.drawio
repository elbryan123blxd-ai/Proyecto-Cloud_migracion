<mxfile host="app.diagrams.net">
  <diagram name="Arquitectura AWS" id="arq-academia-premier">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===================== CONTENEDOR AWS CLOUD ===================== -->
        <mxCell id="awscloud" value="AWS Cloud — us-east-2 (Ohio)" style="fillColor=none;strokeColor=#232F3E;verticalAlign=top;fontSize=15;fontColor=#232F3E;align=left;spacingLeft=58;spacingTop=8;dashed=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="1440" height="940" as="geometry" />
        </mxCell>
        <mxCell id="awslogo" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=0;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="206" y="56" width="58" height="38" as="geometry" />
        </mxCell>

        <!-- ===================== USUARIO (fuera de AWS) ===================== -->
        <mxCell id="user" value="Alumno / Docente&#10;Tutor / Director" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;shape=mxgraph.aws4.user;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="62" y="250" width="64" height="64" as="geometry" />
        </mxCell>

        <!-- ===================== CAPA 1: ENTRADA ===================== -->
        <mxCell id="lbl_entrada" value="ENTRADA" style="text;html=1;fontSize=11;fontColor=#879196;fontStyle=1;align=left;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="150" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value="Amazon CloudFront&#10;(CDN · puerta de entrada)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;fillColor=#3334B9;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="190" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ===================== CAPA 2: COMPUTO PUBLICO ===================== -->
        <mxCell id="lbl_front" value="FRONTEND" style="text;html=1;fontSize=11;fontColor=#879196;fontStyle=1;align=left;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="360" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="apps" value="Apps Next.js&#10;Lambda / Amplify&#10;(dashboard · alumno · docente · tutor)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;fillColor=#D05C17;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="400" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="alb" value="Application Load Balancer&#10;(reparte el trafico de API)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;fillColor=#3334B9;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="400" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ===================== SUB-CONTENEDOR: RED PRIVADA ===================== -->
        <mxCell id="vpc" value="Red privada (VPC) — sin acceso directo desde Internet" style="fillColor=none;strokeColor=#00A4A6;dashed=1;verticalAlign=top;fontSize=12;fontColor=#00A4A6;align=left;spacingLeft=12;spacingTop=6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="540" y="560" width="520" height="380" as="geometry" />
        </mxCell>

        <mxCell id="lbl_servicios" value="SERVICIOS (el &quot;Supabase propio&quot;)" style="text;html=1;fontSize=11;fontColor=#879196;fontStyle=1;align=left;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="610" width="260" height="20" as="geometry" />
        </mxCell>
        <mxCell id="gotrue" value="GoTrue&#10;ECS Fargate&#10;(autenticacion)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;fillColor=#D05C17;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="78" height="78" as="geometry" />
        </mxCell>
        <mxCell id="postgrest" value="PostgREST&#10;ECS Fargate&#10;(API REST)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#F78E04;fillColor=#D05C17;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="lbl_datos" value="DATOS" style="text;html=1;fontSize=11;fontColor=#879196;fontStyle=1;align=left;letterSpacing=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="820" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="aurora" value="Aurora Serverless v2&#10;Postgres · escala a 0&#10;(25 tablas + RLS)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;fillColor=#3334B9;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="820" width="78" height="78" as="geometry" />
