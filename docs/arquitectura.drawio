<mxfile host="app.diagrams.net">
  <diagram name="Arquitectura AWS" id="arq-academia-premier">
    <mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="950" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Contenedor AWS Cloud -->
        <mxCell id="awscloud" value="AWS Cloud" style="fillColor=none;strokeColor=#232F3E;verticalAlign=top;fontSize=16;fontColor=#232F3E;align=left;spacingLeft=55;spacingTop=5;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="60" width="1180" height="820" as="geometry" />
        </mxCell>
        <mxCell id="awslogo" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;grStroke=0;html=1;verticalLabelPosition=bottom;labelBackgroundColor=none;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="205" y="55" width="60" height="38" as="geometry" />
        </mxCell>

        <!-- Usuario -->
        <mxCell id="user" value="Usuario" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3E;strokeColor=none;shape=mxgraph.aws4.user;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;verticalAlign=top;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="60" height="60" as="geometry" />
