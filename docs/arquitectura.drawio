<mxfile host="app.diagrams.net">
  <diagram name="Arquitectura AWS" id="arq-academia-premier">
    <mxGraphModel dx="1800" dy="1100" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITULO ============ -->
        <mxCell id="titulo" value="Academia Premier — replica sobre AWS" style="text;html=1;fontSize=22;fontColor=#232F3E;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="700" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitulo" value="SaaS multi-tenant: GoTrue + PostgREST reemplazan a Supabase, sobre RDS PostgreSQL" style="text;html=1;fontSize=14;fontColor=#879196;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="96" width="800" height="24" as="geometry" />
        </mxCell>

        <!-- ============ CONTENEDOR AWS CLOUD ============ -->
        <mxCell id="awscloud" value="AWS Cloud · us-east-2 (Ohio)" style="fillColor=none;strokeColor=#232F3E;verticalAlign=top;fontSize=14;fontColor=#232F3E;align=left;spacingLeft=56;spacingTop=10;dashed=0;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="180" width="1240" height="640" as="geometry" />
