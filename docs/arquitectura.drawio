          <mxGeometry x="280" y="820" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ===================== BLOQUE APARTE: BACKEND DE TERRAFORM ===================== -->
        <mxCell id="tfbox" value="Backend de Terraform — guarda el ESTADO de la infraestructura.&#10;No participa del runtime de la app: nadie que usa la web pasa por aca." style="fillColor=#F7F7F7;strokeColor=#7D4CDB;dashed=1;verticalAlign=top;fontSize=12;fontColor=#7D4CDB;align=left;spacingLeft=12;spacingTop=6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1140" y="140" width="460" height="340" as="geometry" />
        </mxCell>

        <mxCell id="tfcli" value="Terraform&#10;(tu laptop / GitHub Actions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7D4CDB;fontColor=#232F3E;fontSize=12;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1250" y="180" width="240" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s3tf" value="S3&#10;terraform.tfstate&#10;(versionado + cifrado)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#60A337;fillColor=#277116;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#F7F7F7;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1210" y="300" width="78" height="78" as="geometry" />
        </mxCell>

        <mxCell id="dynamo" value="DynamoDB&#10;lock del estado&#10;(evita 2 apply a la vez)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;fillColor=#3334B9;strokeColor=none;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;html=1;verticalLabelPosition=bottom;labelBackgroundColor=#F7F7F7;verticalAlign=top;align=center;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1420" y="300" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Terraform construye todo lo demas -->
        <mxCell id="tfcrea" value="crea y versiona&#10;toda esta infraestructura" style="text;html=1;fontSize=11;fontColor=#7D4CDB;align=center;fontStyle=2;" vertex="1" parent="1">
