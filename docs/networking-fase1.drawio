        </mxCell>
        <mxCell id="tabla_sg" value="sg-alb            IN  443/tcp    &#8592; 0.0.0.0/0 (Internet)&#10;sg-servicios      IN  todo/tcp  &#8592; sg-alb&#10;sg-aurora         IN  5432/tcp  &#8592; sg-servicios&#10;sg-vpc-endpoints  IN  443/tcp    &#8592; sg-servicios&#10;&#10;Nadie se salta un escalon: Internet nunca habla directo con Aurora ni con los endpoints." style="text;html=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1292" width="680" height="110" as="geometry" />
        </mxCell>

        <mxCell id="tabla_rt_titulo" value="Route tables" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="780" y="1260" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tabla_rt" value="rt-publica  (ambas subredes publicas)&#10;  0.0.0.0/0   -&gt; Internet Gateway&#10;  10.0.0.0/16 -&gt; local (implicita)&#10;&#10;rt-privada  (ambas subredes privadas)&#10;  10.0.0.0/16 -&gt; local (implicita)&#10;  S3          -&gt; VPC Endpoint Gateway&#10;  -- SIN ruta 0.0.0.0/0: no hay NAT Gateway --" style="text;html=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="1292" width="560" height="130" as="geometry" />
        </mxCell>

        <mxCell id="tabla_flujo_titulo" value="El camino de un login, paso a paso" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1260" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tabla_flujo" value="① Alumno abre la app, HTTPS&#10;② Entra por el Internet Gateway&#10;③ Llega al ALB (subred publica), puerto 443&#10;④ ALB reparte por sg-alb -&gt; sg-servicios&#10;⑤ GoTrue valida contra Aurora, puerto 5432&#10;⑥ GoTrue pide la password a Secrets Manager&#10;   via VPC Endpoint, puerto 443 -- nunca sale&#10;   a Internet para hacerlo" style="text;html=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1400" y="1292" width="560" height="150" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
