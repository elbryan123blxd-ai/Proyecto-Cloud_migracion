        <!-- ===================== TABLA: SECURITY GROUPS ===================== -->
        <mxCell id="tabla_sg_titulo" value="Security groups — origen, destino y puerto" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="tabla_sg" value="sg-alb            IN  443/tcp    ← 0.0.0.0/0 (Internet)&#10;sg-servicios      IN  todo/tcp  ← sg-alb&#10;sg-aurora         IN  5432/tcp  ← sg-servicios&#10;sg-vpc-endpoints  IN  443/tcp    ← sg-servicios&#10;&#10;Nadie se salta un escalon: Internet nunca le habla directo a Aurora ni a los VPC Endpoints." style="text;html=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=0;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1160" width="620" height="110" as="geometry" />
        </mxCell>

        <!-- ===================== TABLA: ROUTE TABLES ===================== -->
