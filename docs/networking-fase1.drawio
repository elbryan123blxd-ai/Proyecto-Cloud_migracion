        </mxCell>
        <mxCell id="tabla_rt" value="rt-publica  (subredes publicas)&#10;  0.0.0.0/0   → Internet Gateway&#10;  10.0.0.0/16 → local (implicita)&#10;&#10;rt-privada  (subredes privadas)&#10;  10.0.0.0/16 → local (implicita)&#10;  (S3)        → VPC Endpoint Gateway&#10;  -- SIN ruta 0.0.0.0/0: no hay NAT Gateway --" style="text;html=1;fontSize=11;fontFamily=Courier New;align=left;verticalAlign=top;fillColor=#F5F5F5;strokeColor=#CCCCCC;rounded=0;spacing=8;" vertex="1" parent="1">
